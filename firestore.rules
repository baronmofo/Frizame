rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Products Collection
    match /products/{productId} {
      allow read, write: if true;
    }

    // Clients Collection
    match /clients/{clientId} {
      allow read, write: if true;
    }

    // Movements (Stock Transactions)
    match /movements/{movementId} {
      allow read, create, update: if true;
      allow delete: if false; // Audit trail records cannot be deleted
    }

    // Raw Materials Collection
    match /rawMaterials/{rawMaterialId} {
      allow read, write: if true;
    }

    // Recipes Collection
    match /recipes/{recipeId} {
      allow read, write: if true;
    }

    // Orders OP Collection
    match /ordersOP/{orderId} {
      allow read, write: if true;
    }

    // Suppliers Collection
    match /suppliers/{supplierId} {
      allow read, write: if true;
    }

    // System Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Audit History Event Log
    match /historyEvents/{eventId} {
      allow read, create: if true;
      allow update, delete: if false; // Strict Immutability Guard
    }

    // System Configuration Collection
    match /systemConfig/{configId} {
      allow read, write: if true;
    }

    // Application State Collection (Real-time device sync)
    match /appState/{docId} {
      allow read, write: if true;
    }

    // Backups Collection
    match /backups/{backupId} {
      allow read, write: if true;
    }

    // Health / Test Collection
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
