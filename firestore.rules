rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Products collection: Readable by authenticated users, writable by authenticated users
    match /products/{productId} {
      allow read, write: if isSignedIn();
    }

    // Users collection: Readable and writable by authenticated users
    match /users/{userId} {
      allow read, write: if isSignedIn();
    }

    // Clients collection
    match /clients/{clientId} {
      allow read, write: if isSignedIn();
    }
  }
}
